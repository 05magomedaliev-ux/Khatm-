# Строка подключения к PostgreSQL. В Supabase: Project Settings > Database >
# Connection string > Transaction pooler (порт 6543). Параметр sslmode указывать не нужно.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# require: шифрование обязательно (для Supabase). off: для локальной базы.
DATABASE_SSL=require
# Необязательно: путь к сертификату Supabase для полной проверки сервера.
# DATABASE_CA_CERT=/app/supabase-ca.crt

# От @BotFather
BOT_TOKEN=123456:REPLACE_ME
# Имя бота без @
BOT_USERNAME=khatm_nash_put_bot

# Публичный HTTPS-адрес приложения
WEBAPP_URL=https://your-app.example.com

# webhook — для сервера с постоянным адресом, polling — для локального запуска, off — без бота
BOT_MODE=webhook
# Необязательно: если не указать, секрет будет получен из токена бота
# WEBHOOK_SECRET=

PORT=3000

# on: при запуске сервер сам создаст таблицы и первую группу и выведет первую ссылку в журнал.
# На Render включено по умолчанию.
# AUTO_SETUP=on
